# Local secrets. Copy to .env, keep the file private, and never commit values.
# DeepSeek hosted API used by deepseek-flash.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
TUSHARE_TOKEN=

# Official TuShare token, used only by the nightly announcement-title job
# (cn_nightly_anns_full); when it is missing or refused, that job alone stops.
TUSHARE_TOKEN_TMP=

# Optional TuShare overrides: relay endpoint and update backfill start date.
TUSHARE_RELAY_URL=
TUSHARE_UPDATE_START_DATE=

# GPU card indices this project may take on a host shared with other users
# (comma-separated nvidia-smi indices); empty lets it take every card.
AUTOTRADE_GPU_ALLOW=

# Local Qwen gateway (vLLM FP8 TP=2 dual L20 on GPU 6+7 behind the shared
# vllm-service at /Data/lzp/vllm-service) used by qwen-3.8-27b-fp8.
# VLLM_API_KEY is the single Bearer key shared by the gateway and this client;
# the gateway refuses to start when it is empty.
VLLM_BASE_URL=http://127.0.0.1:8011/v1
VLLM_API_KEY=

# Xiaomi MiMo hosted API used by mimo-v2.6-flash and mimo-v2.6-pro (one key for
# both). A pay-as-you-go key (sk-...)
# uses the default base URL; a Token Plan key (tp-.../ttp-...) or an overseas
# account needs the base URL its MiMo console shows.
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# LightingTheWord relay (New API) used by gpt-6.1-sol, gpt-6-astra, gpt-6-luna,
# claude-fable-5-1, claude-sonnet-5-5, claude-opus-5-5, gemini-4-argon and
# DeepSeek-V4.1-Flash.
# LIGHTING_API_KEY_ALT is optional: a request the primary key's account rejects
# or has run dry on is sent once more with it.
LIGHTING_API_KEY=
LIGHTING_API_KEY_ALT=
LIGHTING_BASE_URL=https://lightingtheword.com/v1
