# ADM-Cube ZGCA sync: bring every ended experiment of the ZGCA rounds back here, once.
# Install or refresh with: /home/lzp/miniconda3/envs/quant/bin/python ops/cron/install_cron.py --block zgca
#
# Experiments run on the ZGCA instance (ops/zgca/README.md). Each run is one
# `zgca.py sync-rounds` pass over the experiments of the round files below: an
# experiment already settled (its marker in .runtime/zgca/synced/ says
# `released`, or `synced` for one that did not complete) costs nothing, any
# other costs one remote query, and only one that has ended is copied, given its
# pinned sandbox image tag and, when it completed, released on the instance (its
# bulk freed under the storage quota, its records kept), as `zgca.py sync` does.
# A running or not yet created experiment is left alone; one copied whose tag
# was refused is only tagged again, every run, until the images agree; a failure
# is one line and the next experiment still goes ahead; a stopped or
# unreachable instance is one line and the next run tries again. Every run ends
# with one summary line, so `tail -1 logs/zgca/sync_cron.log` shows the state;
# it exits non-zero when something needs the operator. It opens no Paper account.

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
CRON_TZ=Asia/Shanghai
REPO_ROOT=/Data2/lzp/auto-trade
QUANT_PYTHON=/home/lzp/miniconda3/envs/quant/bin/python
# The ZGCA round files whose experiments may still have to come back,
# separated by spaces; a closed round stays until all of them are synced, and
# leaves before its file leaves the tree. Empty: each run only writes its line.
ROUNDS=scripts/experiments/create_round_20261119.py

# Every 30 minutes, all day: an experiment runs for hours and ends at no
# particular hour. A copy of a 6-10 GB experiment takes about an hour through
# the jump host; `flock -n` skips the runs that fall meanwhile.
*/30 * * * * cd $REPO_ROOT && mkdir -p logs/zgca .runtime/zgca && flock -n .runtime/zgca/sync_cron.lock $QUANT_PYTHON ops/zgca/zgca.py sync-rounds $ROUNDS >> logs/zgca/sync_cron.log 2>&1
