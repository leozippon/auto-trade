# ADM-Cube ZGCA sync: bring every ended experiment of the ZGCA rounds back here, once.
# Install or refresh with: /home/lzp/miniconda3/envs/quant/bin/python ops/cron/install_cron.py --block zgca
#
# Each run is one `zgca.py sync-rounds` pass over the experiments of the round
# files below. What a pass copies, tags and releases, the lines it writes and
# its exit status are in ops/zgca/README.md (sync, sync-rounds); `tail -1
# logs/zgca/sync_cron.log` and its time show the state.

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
CRON_TZ=Asia/Shanghai
REPO_ROOT=/Data2/lzp/auto-trade
QUANT_PYTHON=/home/lzp/miniconda3/envs/quant/bin/python
# The ZGCA round files whose experiments may still have to come back,
# separated by spaces; a closed round stays until all of them are synced, and
# leaves before its file leaves the tree. Empty: each run only writes its line.
ZGCA_ROUNDS=scripts/experiments/create_round_20261121.py

# Every 30 minutes, all day: an experiment ends at no particular hour. A copy
# of a 6-10 GB experiment takes about an hour through the jump host, so a run
# can find the lock held, and ops/cron/locked.sh ends a run at 4 h: three such
# copies and a margin.
*/30 * * * * cd $REPO_ROOT && mkdir -p logs/zgca .runtime/zgca && ops/cron/locked.sh .runtime/zgca/sync_cron.lock 4h "zgca sync" $QUANT_PYTHON ops/zgca/zgca.py sync-rounds $ZGCA_ROUNDS >> logs/zgca/sync_cron.log 2>&1
